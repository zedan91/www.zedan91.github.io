{
  "functions": [
    {
      "source": "functions",
      "codebase": "azobss-cleanup",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "package.json",
      "package-lock.json",
      "deploy-server.js",
      "Dockerfile",
      ".dockerignore",
      ".npmrc",
      "backend/**",
      "lib/**",
      "scripts/**",
      "tests/**",
      "AZOBSS-Developer-Files/**",
      ".azobss-libredwg/**",
      "README*.md",
      "**/README*.md",
      "*-AUDIT-*.json",
      "*_AUDIT.json",
      "FIREBASE-RULES-*.txt",
      "admin-preview-*.html",
      "_badge-test.html"
    ]
  }
}
