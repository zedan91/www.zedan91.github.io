{
  "manifest_version": 2,
  "name": "AZOBSS WhatsApp Tab Reuse & PDF Bridge",
  "version": "1.3.1",
  "description": "Prepare one PDF with document notes in WhatsApp Web, reuse tabs and leave Send to the admin.",
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "https://azobss.com/admin/*",
    "https://www.azobss.com/admin/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": [
      "tab-router.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://azobss.com/admin/*",
        "https://www.azobss.com/admin/*"
      ],
      "js": [
        "azobss-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "chat-target.js",
        "whatsapp-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "azobss-firefox-whatsapp-pdf@azobss.com",
      "strict_min_version": "109.0"
    }
  }
}