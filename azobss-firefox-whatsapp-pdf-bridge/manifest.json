{
  "manifest_version": 2,
  "name": "AZOBSS WhatsApp Tab Reuse & PDF Bridge",
  "version": "1.1.0",
  "description": "Reuse an existing WhatsApp Web tab for AZOBSS customer chats, without sending messages.",
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "https://azobss.com/admin/*",
    "https://www.azobss.com/admin/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": [
      "tab-router.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://azobss.com/admin/*",
        "https://www.azobss.com/admin/*"
      ],
      "js": [
        "azobss-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "azobss-firefox-whatsapp-pdf@azobss.com",
      "strict_min_version": "109.0"
    }
  }
}