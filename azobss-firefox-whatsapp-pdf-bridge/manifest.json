{
  "manifest_version": 2,
  "name": "AZOBSS Firefox WhatsApp PDF Bridge",
  "version": "1.0.0",
  "description": "Attach AZOBSS invoice/receipt PDFs as real files in WhatsApp Web when sharing from Firefox.",
  "permissions": [
    "tabs",
    "storage",
    "https://azobss.com/admin/*",
    "https://www.azobss.com/admin/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://azobss.com/admin/*",
        "https://www.azobss.com/admin/*"
      ],
      "js": ["azobss-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "azobss-firefox-whatsapp-pdf@azobss.com",
      "strict_min_version": "109.0"
    }
  }
}
