PORT=3000
ADMIN_KEY=put-a-long-random-admin-secret-here
PUBLIC_BASE_URL=https://your-render-app.onrender.com
DATA_DIR=./data
UPLOAD_DIR=./uploads
CORS_ORIGIN=https://azobss.com,http://localhost:5500,http://127.0.0.1:5500
TZ=Asia/Kuala_Lumpur

# ToyyibPay payment gateway
TOYYIB_SECRET_KEY=your_toyyibpay_secret_key_here
TOYYIB_CATEGORY_CODE=wqrblyk7
PUBLIC_BASE_URL=https://azobss-backend.onrender.com
FRONTEND_BASE_URL=https://www.azobss.com
TOYYIB_BASE_URL=https://toyyibpay.com
TOYYIB_RETURN_URL=https://azobss-backend.onrender.com/api/toyyib/return
TOYYIB_CALLBACK_URL=https://azobss-backend.onrender.com/api/toyyib-callback
TOYYIB_SANDBOX=false

# Email SMTP for automatic download link delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_google_app_password
MAIL_FROM=yourgmail@gmail.com


# Recommended branded verification sender (AZOBSS 694)
# Verify azobss.com as a sender domain in Brevo and add the exact DNS records Brevo supplies.
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=noreply@azobss.com
MAIL_FROM_NAME=AZOBSS
AUTH_VERIFY_CONTINUE_URL=https://www.azobss.com/?azobssVerified=1
